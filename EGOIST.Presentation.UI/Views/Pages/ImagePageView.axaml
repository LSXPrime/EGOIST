<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:interactions="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:vm="using:EGOIST.Presentation.UI.ViewModels.Pages"
             xmlns:services="using:EGOIST.Presentation.UI.Services"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:DataType="vm:ImagePageViewModel"
             x:Class="EGOIST.Presentation.UI.Views.Pages.ImagePageView">

    <Grid RowDefinitions="88*,12*">

        <TransitioningContentControl Grid.Row="0" Margin="0,0,0,20"
                                     Content="{Binding Source={x:Static services:NavigationService.Current}, Path=Sub}" />

        <!-- Model Selection -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.0" />
                    <GradientStop Color="#44000000" Offset="0.5" />
                    <GradientStop Color="#22000000" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Control Net & LoRa & Vae -->
            <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  ColumnDefinitions="*,*,*,*,*" Margin="0,20,0,0">
                <StackPanel Grid.Column="0" Margin="10,0">
                    <Label Content="Control Net" FontFamily="Cambria" FontWeight="Bold" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding ControlNetWeights}"
                              SelectedItem="{Binding SelectedControlNetWeight}" DisplayMemberBinding="{Binding Weight}"
                              FontSize="24" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0">
                    <Label Content="Taesd" FontFamily="Cambria" FontWeight="Bold" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding TaesdWeights}" SelectedItem="{Binding SelectedTaesdWeight}"
                              DisplayMemberBinding="{Binding Weight}" FontSize="24" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0">
                    <Label Content="Vae" FontFamily="Cambria" FontWeight="Bold" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding VaeWeights}" SelectedItem="{Binding SelectedVaeWeight}"
                              DisplayMemberBinding="{Binding Weight}" FontSize="24" HorizontalAlignment="Stretch" />
                </StackPanel>
                
                <!-- Model Selection & Unloading -->
                <StackPanel Grid.Column="3" Margin="10,0">
                    <Label Content="Model" FontFamily="Cambria" FontWeight="Bold" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedGenerationModel}"
                              DisplayMemberBinding="{Binding Name}" FontSize="24" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="10,0">
                    <Label Content="Weight" FontFamily="Cambria" FontWeight="Bold" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding SelectedGenerationModel.Weights, FallbackValue={x:Null}}"
                              SelectedItem="{Binding SelectedGenerationWeight}" DisplayMemberBinding="{Binding Weight}"
                              FontSize="24" HorizontalAlignment="Stretch">
                        <interactivity:Interaction.Behaviors>
                            <interactions:EventTriggerBehavior EventName="SelectionChanged">
                                <interactions:InvokeCommandAction Command="{Binding SwitchModelCommand}" />
                            </interactions:EventTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,45,10,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                <icons:SymbolIcon Symbol="Circle" Width="50" Height="45" FontSize="32"
                                  IsVisible="{Binding ModelCoreService.State, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Started}"
                                  ToolTip.Tip="{Binding SelectedGenerationModel.Name, FallbackValue='Loading Model' , StringFormat='Loading Model: {0}'}" />
                <Button Width="50" Height="45" Command="{Binding UnloadModelCommand}"
                        ToolTip.Tip="{Binding SelectedGenerationModel.Name, FallbackValue='Unload Current Model: Already Unloaded' , StringFormat='Unload Current Model: {0}'}">
                    <icons:SymbolIcon Symbol="ArrowReset" FontSize="24" />
                </Button>
                <Button Width="50" Height="45" Command="{Binding RefreshModelsCommand}"
                        ToolTip.Tip="Refresh Models List">
                    <icons:SymbolIcon Symbol="ArrowRepeatAll" FontSize="24" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>